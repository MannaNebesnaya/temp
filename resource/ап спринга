    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>UTF-8</encoding>
                    <!-- ДОБАВЛЕНО: требуется для Spring Boot 3 (parameter name discovery) -->
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <annotationProcessorPath>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                            <version>${spring.version}</version>
                        </annotationProcessorPath>
                        <annotationProcessorPath>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </annotationProcessorPath>
                        <annotationProcessorPath>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>0.2.0</version>
                        </annotationProcessorPath>
                        <annotationProcessorPath>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${org.mapstruct.version}</version>
                        </annotationProcessorPath>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.version}</version>
            </plugin>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <!-- TODO: рассмотреть обновление до 7.x для полной Jakarta-поддержки -->
                <version>6.2.1</version>
                <executions>
                    <execution>
                        <id>1</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/resources/webschema/swagger/qrEntity.yml</inputSpec>
                            <generatorName>spring</generatorName>
                            <output>${basedir}/target/generated-sources</output>
                            <modelPackage>ru.mtsbank.sbp.qrentity.model.request.model</modelPackage>
                            <apiPackage>ru.mtsbank.sbp.qrentity.model.request.api</apiPackage>
                            <templateDirectory>src/main/resources/openapi-templates</templateDirectory>
                            <configOptions>
                                <additionalModelTypeAnnotations>@com.fasterxml.jackson.annotation.JsonInclude(com.fasterxml.jackson.annotation.JsonInclude.Include.NON_NULL)</additionalModelTypeAnnotations>
                                <library>spring-cloud</library>
                                <openApiNullable>false</openApiNullable>
                                <sourceFolder>src/main/java</sourceFolder>
                                <interfaceOnly>true</interfaceOnly>
                                <useTags>true</useTags>
                                <!-- ДОБАВИТЬ для Boot 3: генерировать Jakarta imports -->
                                <useSpringBoot3>true</useSpringBoot3>
                            </configOptions>
                        </configuration>
                    </execution>
                    <execution>
                        <id>2</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/resources/webschema/swagger/zkOpenApi.yml</inputSpec>
                            <generatorName>spring</generatorName>
                            <output>${basedir}/target/generated-sources</output>
                            <modelPackage>ru.mtsbank.sbp.qrentity.model.request.model</modelPackage>
                            <apiPackage>ru.mtsbank.sbp.qrentity.model.request.api</apiPackage>
                            <templateDirectory>src/main/resources/openapi-templates</templateDirectory>
                            <skipValidateSpec>true</skipValidateSpec>
                            <skipOperationExample>true</skipOperationExample>
                            <configOptions>
                                <additionalModelTypeAnnotations>@com.fasterxml.jackson.annotation.JsonInclude(com.fasterxml.jackson.annotation.JsonInclude.Include.NON_NULL)</additionalModelTypeAnnotations>
                                <library>spring-cloud</library>
                                <openApiNullable>false</openApiNullable>
                                <sourceFolder>src/main/java</sourceFolder>
                                <interfaceOnly>true</interfaceOnly>
                                <useTags>true</useTags>
                                <useSpringBoot3>true</useSpringBoot3>
                            </configOptions>
                        </configuration>
                    </execution>
                    <execution>
                        <id>3</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/resources/webschema/swagger/nspkOpenApi.yml</inputSpec>
                            <generatorName>spring</generatorName>
                            <output>${basedir}/target/generated-sources</output>
                            <modelPackage>ru.mtsbank.sbp.qrentity.model.request.model</modelPackage>
                            <apiPackage>ru.mtsbank.sbp.qrentity.model.request.api</apiPackage>
                            <templateDirectory>src/main/resources/openapi-templates</templateDirectory>
                            <skipValidateSpec>true</skipValidateSpec>
                            <skipOperationExample>true</skipOperationExample>
                            <configOptions>
                                <additionalModelTypeAnnotations>@com.fasterxml.jackson.annotation.JsonInclude(com.fasterxml.jackson.annotation.JsonInclude.Include.NON_NULL)</additionalModelTypeAnnotations>
                                <library>spring-boot</library>
                                <openApiNullable>false</openApiNullable>
                                <sourceFolder>src/main/java</sourceFolder>
                                <interfaceOnly>true</interfaceOnly>
                                <useTags>true</useTags>
                                <useSpringBoot3>true</useSpringBoot3>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>add-generated-source</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${basedir}/target/generated-sources</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>dependency-analyze</id>
                        <goals>
                            <goal>analyze-only</goal>
                        </goals>
                        <configuration>
                            <ignoreNonCompile>true</ignoreNonCompile>
                            <failOnWarning>false</failOnWarning>
                            <ignoredUnusedDeclaredDependencies>
                                <!-- ИЗМЕНЕНО: com.sun.xml.bind → org.glassfish.jaxb -->
                                <ignoredUnusedDeclaredDependency>org.glassfish.jaxb:jaxb-runtime</ignoredUnusedDeclaredDependency>
                                <ignoredUnusedDeclaredDependency>org.projectlombok:lombok</ignoredUnusedDeclaredDependency>
                                <ignoredUnusedDeclaredDependency>org.apache.cxf.xjcplugins:cxf-xjc-ts</ignoredUnusedDeclaredDependency>
                                <ignoredUnusedDeclaredDependency>net.logstash.logback:logstash-logback-encoder</ignoredUnusedDeclaredDependency>
                                <!-- игнорировать resilience4j зависимости -->
                                <ignoredUnusedDeclaredDependency>io.github.resilience4j:resilience4j-spring</ignoredUnusedDeclaredDependency>
                            </ignoredUnusedDeclaredDependencies>
                            <ignoredDependencies>
                                <ignoredDependency>org.springframework*:*</ignoredDependency>
                                <ignoredDependency>io.micrometer*:*</ignoredDependency>
                                <ignoredDependency>org.openapitools*:*</ignoredDependency>
                                <ignoredDependency>org.apache.tomcat*:*</ignoredDependency>
                                <ignoredDependency>org.junit*:*</ignoredDependency>
                                <!-- ИЗМЕНЕНО: javax.servlet → jakarta.servlet -->
                                <ignoredDependency>jakarta.servlet:*</ignoredDependency>
                                <ignoredDependency>org.slf4j:slf4j-api</ignoredDependency>
                                <ignoredDependency>io.github.openfeign:feign-core</ignoredDependency>
                                <!-- ИЗМЕНЕНО: javax.xml.bind → jakarta.xml.bind -->
                                <ignoredDependency>jakarta.xml.bind:*</ignoredDependency>
                                <ignoredDependency>jakarta*:*</ignoredDependency>
                                <ignoredDependency>org.apache.httpcomponents:*</ignoredDependency>
                                <!-- ИЗМЕНЕНО: springdoc-openapi-ui → springdoc-openapi-starter-webmvc-ui -->
                                <ignoredDependency>org.springdoc:springdoc-openapi-starter-webmvc-ui</ignoredDependency>
                                <ignoredDependency>org.mockito*:*</ignoredDependency>
                                <ignoredDependency>org.assertj*:*</ignoredDependency>
                                <ignoredDependency>org.zalando:*</ignoredDependency>
                                <ignoredDependency>io.github.resilience4j:*</ignoredDependency>
                            </ignoredDependencies>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- ВЕРСИЯ ИЗМЕНЕНА: 2.0.9 → 4.0.8 (Jakarta namespace) -->
                <groupId>org.jvnet.jaxb</groupId>
                <artifactId>jaxb-maven-plugin</artifactId>
                <version>${jaxb2-basics.version}</version>
                <executions>
                    <execution>
                        <id>schema-generate</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <forceRegenerate>true</forceRegenerate>
                            <extension>true</extension>
                            <bindingDirectory>src/main/resources/webschema</bindingDirectory>
                            <bindingIncludes>
                                <include>*.xjb</include>
                            </bindingIncludes>
                            <schemaDirectory>src/main/resources/webschema/orglistmodnf</schemaDirectory>
                            <schemaIncludes>
                                <include>OrgListModNf.xsd</include>
                            </schemaIncludes>
                            <generatePackage>ru.mtsbank.sbp.qrentity.model.xsd.orglistmodnf</generatePackage>
                            <generateDirectory>${project.build.directory}/generated-xsd/orglistmodnf</generateDirectory>
                            <args>
                                <arg>-XautoNameResolution</arg>
                                <arg>-Xannotate</arg>
                                <arg>-nv</arg>
                                <arg>-XtoString</arg>
                                <arg>-Xequals</arg>
                                <arg>-XhashCode</arg>
                                <arg>-Xinheritance</arg>
                                <arg>-Xcopyable</arg>
                                <arg>-XenumValue</arg>
                            </args>
                            <plugins>
                                <plugin>
                                    <groupId>org.jvnet.jaxb</groupId>
                                    <artifactId>jaxb2-basics</artifactId>
                                    <version>${jaxb2-basics.version}</version>
                                </plugin>
                                <!-- TODO: проверить Jakarta-совместимость этих плагинов -->
                                <plugin>
                                    <groupId>org.jvnet.jaxb2_commons</groupId>
                                    <artifactId>jaxb2-basics-annotate</artifactId>
                                    <version>${jaxb2-basics-annotate.version}</version>
                                </plugin>
                                <plugin>
                                    <groupId>org.jvnet.jaxb2_commons</groupId>
                                    <artifactId>jaxb2-basics</artifactId>
                                    <version>1.11.1</version>
                                </plugin>
                            </plugins>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
