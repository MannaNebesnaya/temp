              { "id": "decimals", "value": 3 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #ErrorRate" },
            "properties": [
              { "id": "displayName", "value": "Error %" },
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 2 },
