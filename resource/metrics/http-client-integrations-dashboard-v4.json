        ]
      },
      "title": "Endpoint Summary Table",
      "description": "Сводная таблица по всем эндпоинтам: RPS, % ошибок, средняя и максимальная задержка, общее количество запросов за период.",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(http_client_requests_seconds_count{application=\"$application\", instance=~\"$instance\", uri=~\"$uri\", clientName=~\"$clientName\"}[$__rate_interval])) by (method, uri, clientName)",
          "format": "table",
          "instant": true,
          "refId": "RPS",
          "legendFormat": ""
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(http_client_requests_seconds_count{application=\"$application\", instance=~\"$instance\", uri=~\"$uri\", clientName=~\"$clientName\", outcome=~\"SERVER_ERROR|CLIENT_ERROR\"}[$__rate_interval])) by (method, uri, clientName) / sum(rate(http_client_requests_seconds_count{application=\"$application\", instance=~\"$instance\", uri=~\"$uri\", clientName=~\"$clientName\"}[$__rate_interval])) by (method, uri, clientName) * 100",
          "format": "table",
          "instant": true,
          "refId": "ErrorRate",
          "legendFormat": ""
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(http_client_requests_seconds_sum{application=\"$application\", instance=~\"$instance\", uri=~\"$uri\", clientName=~\"$clientName\"}[$__rate_interval])) by (method, uri, clientName) / sum(rate(http_client_requests_seconds_count{application=\"$application\", instance=~\"$instance\", uri=~\"$uri\", clientName=~\"$clientName\"}[$__rate_interval])) by (method, uri, clientName)",
          "format": "table",
          "instant": true,
          "refId": "AvgLatency",
          "legendFormat": ""
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(http_client_requests_seconds_max{application=\"$application\", instance=~\"$instance\", uri=~\"$uri\", clientName=~\"$clientName\"}) by (method, uri, clientName)",
          "format": "table",
          "instant": true,
          "refId": "MaxLatency",
          "legendFormat": ""
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(http_client_requests_seconds_count{application=\"$application\", instance=~\"$instance\", uri=~\"$uri\", clientName=~\"$clientName\"}[$__range])) by (method, uri, clientName)",
          "format": "table",
          "instant": true,
          "refId": "TotalRequests",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
