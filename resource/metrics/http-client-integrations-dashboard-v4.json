            "properties": [
              { "id": "displayName", "value": "Max Latency" },
              { "id": "unit", "value": "s" },
              { "id": "decimals", "value": 3 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #TotalRequests" },
            "properties": [
