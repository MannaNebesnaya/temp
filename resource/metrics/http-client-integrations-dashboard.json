      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(rate(http_client_requests_seconds_count{application=\"$application\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "RPS",
          "refId": "A"
        }
